# WAPL ID Management System environment template.
# Copy to .env and replace placeholders locally. Never commit .env.

# Flask
SECRET_KEY=replace-with-a-random-secret
FLASK_ENV=development
FLASK_DEBUG=false
PORT=5000
APP_DOMAIN=http://localhost:5000

# Database (leave blank to use local SQLite)
DATABASE_URL=

# Email
GMAIL_USER=your-email@gmail.com
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_PASSWORD=your-16-char-app-password
MAIL_SENDER_NAME=WAPL System
EMAIL_DELIVERY_MODE=auto
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Payments
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
DOMAIN_PRICE_INR=166

# Optional Google Cloud Storage
USE_GCS=false
GCS_BUCKET_NAME=your-gcs-bucket-name

# Local monitoring stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
