---
# Copy this file to vault.yml, replace every placeholder, then encrypt it:
# ansible-vault encrypt ansible/group_vars/all/vault.yml
vault_wynara_env: |
  SECRET_KEY=replace-with-a-random-production-secret
  FLASK_ENV=production
  FLASK_DEBUG=false
  APP_DOMAIN=https://your-domain.example
  DATABASE_URL=
  GMAIL_USER=your-email@gmail.com
  GMAIL_APP_PASSWORD=replace-with-gmail-app-password
  MAIL_SENDER_NAME=WAPL System
  EMAIL_DELIVERY_MODE=smtp
  RESEND_API_KEY=replace-with-resend-api-key
  RESEND_FROM_EMAIL=your-sender@example.com
  RAZORPAY_KEY_ID=replace-with-razorpay-key-id
  RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
  DOMAIN_PRICE_INR=166
  USE_GCS=false
  GCS_BUCKET_NAME=your-gcs-bucket
